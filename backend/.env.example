# Copy this file to .env.local and fill in real values. NEVER commit real secrets.
NODE_ENV=development
APP_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32+-char-random-secret

# Postgres connection string (e.g. Neon). Include sslmode=require for managed hosts.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

OLLAMA_BASE_URL=http://127.0.0.1:11434
# Use 'auto' to select the smallest available Ollama model for testing.
# You can also set this explicitly to a model name like qwen3:8b or llama3.2:3b.
OLLAMA_CHAT_MODEL=auto
# Must be a transformers.js (ONNX) model id — use the Xenova conversion.
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
# Allow downloading the embedding model from the hub when not cached (default true).
EMBEDDINGS_ALLOW_REMOTE=true

# Cloudflare R2 (object storage) — leave blank to use local storage in dev.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://your-public-domain-or-r2-dev-subdomain
